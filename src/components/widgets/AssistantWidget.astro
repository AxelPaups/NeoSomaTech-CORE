---
---

<div class="flex flex-col h-full">
  <div class="flex items-center justify-between mb-3">
    <h2 class="widget-title">Agentic Assistant</h2>
    <div class="text-xs text-gray-400">JARVIS-Style</div>
  </div>

  <div class="p-4 rounded-lg" style="background: linear-gradient(180deg, rgba(124,58,237,0.06), rgba(0,229,255,0.02)); border-radius:12px;">
    <!-- Waveform placeholder -->
    <svg width="100%" height="80" viewBox="0 0 600 80" preserveAspectRatio="none">
      <path d="M0 40 C50 10 100 70 150 40 C200 10 250 70 300 40 C350 10 400 70 450 40 C500 10 550 70 600 40" fill="none" stroke="#00e5ff" stroke-width="3" stroke-linecap="round"/>
    </svg>

    <div class="mt-3 text-sm text-gray-200">Ask me about Neosomatech data...</div>
  </div>

  <div class="mt-4 flex-1 overflow-auto">
    <div class="glass-panel text-sm text-gray-300">
      <strong class="text-white">JARVIS:</strong>
      <div class="text-xs text-gray-300">Analysing SEO trends... Exoskeleton K1 leads with +18% organic traffic today.</div>
    </div>
  </div>

  <div class="mt-3">
    <div class="flex gap-2">
      <input class="flex-1 bg-transparent border border-gray-700 rounded px-3 py-2 text-sm" placeholder="Neosomatech data..." />
      <button class="px-3 py-2 bg-[#7c3aed] rounded text-white">→</button>
    </div>
  </div>
</div>
