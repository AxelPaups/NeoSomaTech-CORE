---
// src/components/widgets/DirectusWidget.astro
import { getProduits } from '../../lib/directus';
const produits = await getProduits();
const DIRECTUS_URL = 'https://spirited-squid.pikapod.net';
---

<div class="flex justify-between items-center mb-4">
    <h2 class="widget-title m-0">Directus Content</h2>
    <img src="/logo-neosomatech.png" alt="Logo" class="h-6 w-auto" />
  </div>

  <div class="overflow-y-auto flex-1">
    <ul class="space-y-3">
      {produits.map((prod: any) => (
        <li class="flex items-center gap-3 border-b border-gray-800 pb-2 group">
          <img 
            src={`${DIRECTUS_URL}/assets/${prod.image}?width=50&height=50&fit=cover`} 
            alt={prod.nom_court} 
            class="w-10 h-10 rounded-full object-cover" 
          />
          <span class="text-gray-300 text-sm flex-1">{prod.nom_court}</span>
          
        <a 
  href={`https://neosomatech.com/produits/${prod.slug}`} 
  target="_blank"
  rel="noopener noreferrer"
  class="text-gray-500 hover:text-blue-400 transition-colors p-1"

>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
  </svg>
</a>
        </li>
      ))}
    </ul>
  </div>