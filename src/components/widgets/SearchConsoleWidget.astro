---
---

<div class="flex flex-col gap-4">
  <div class="flex items-start justify-between">
    <h2 class="widget-title m-0">Google Search Console</h2>

    <div class="flex items-center gap-3">
      <div class="glass-panel text-center">
        <div class="text-xs text-gray-400">Clicks</div>
        <div class="text-xl neon-accent font-semibold">1,524</div>
      </div>
      <div class="glass-panel text-center">
        <div class="text-xs text-gray-400">Impressions</div>
        <div class="text-xl text-gray-200 font-semibold">230</div>
      </div>
      <div class="glass-panel text-center">
        <div class="text-xs text-gray-400">CTR</div>
        <div class="text-xl text-gray-200 font-semibold">1.3%</div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div class="p-4 rounded-lg bg-gradient-to-b from-[#07101a] to-[#05101a]">
      <!-- Placeholder simple line chart -->
      <svg width="100%" height="120" viewBox="0 0 300 120" preserveAspectRatio="none">
        <defs>
          <linearGradient id="g1" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#00e5ff" stop-opacity="0.18" />
            <stop offset="100%" stop-color="#7c3aed" stop-opacity="0.02" />
          </linearGradient>
        </defs>
        <path d="M0,80 C50,60 100,40 150,50 C200,60 250,30 300,50 L300,120 L0,120 Z" fill="url(#g1)" stroke="none" />
        <path d="M0,80 C50,60 100,40 150,50 C200,60 250,30 300,50" fill="none" stroke="#00e5ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

    <div class="p-4 rounded-lg bg-gradient-to-b from-[#07101a] to-[#05101a]">
      <!-- Placeholder second chart -->
      <svg width="100%" height="120" viewBox="0 0 300 120" preserveAspectRatio="none">
        <path d="M0,90 C50,70 100,60 150,75 C200,90 250,70 300,80" fill="none" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>

  <div>
    <h3 class="text-sm text-gray-400 mb-2">Top SEO Opportunities</h3>
    <ul class="space-y-2">
      <li class="glass-panel flex items-center justify-between">
        <div>
          <div class="text-sm text-white">Optimize Exoskeleton K1 Page</div>
          <div class="text-xs text-gray-400">Improve meta & content to increase organic traffic</div>
        </div>
        <div class="text-gray-400">→</div>
      </li>
      <li class="glass-panel flex items-center justify-between">
        <div>
          <div class="text-sm text-white">Write about Robotics Trends</div>
          <div class="text-xs text-gray-400">Create a long-form article targeting robotics queries</div>
        </div>
        <div class="text-gray-400">→</div>
      </li>
    </ul>
  </div>
</div>
